# SPDX-License-Identifier: GPL-2.0-only
# POCO F5 (marble) core bring-up fragment for Android/GKI 6.18.
# This selects only symbols present in ACK 6.18; vendor-only drivers remain excluded.

# Storage and platform power required before first-device boot investigation.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y

# Core USB/PHY plumbing available in ACK; Xiaomi-specific DWC3 glue is not selected.
CONFIG_USB_DWC3=y
CONFIG_PHY_QCOM_QMP=y

# Device Tree overlay support required for the marble board overlay.
CONFIG_OF_OVERLAY=y

# PMIC measurement infrastructure available upstream.
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y

# P0 IPC/shared-memory infrastructure with direct ACK bindings in cape.dtsi.
# qcom,ipcc, qcom,tcsr-mutex, qcom,smem and qcom,smp2p are all present in
# the board DT and have matching upstream drivers in this 6.18 tree.
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
