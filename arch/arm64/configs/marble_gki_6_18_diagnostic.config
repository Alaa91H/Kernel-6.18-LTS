# SPDX-License-Identifier: GPL-2.0-only
# POCO F5 (marble) diagnostic-only fragment for Android/GKI 6.18.
# Do not merge into the release flavor without device validation.

# Keep BTF present for symbol-aware inspection and later KMI checks.
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# Runtime-selectable driver diagnostics and persistent crash tracing.
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_BOOTTIME_TRACING=y
CONFIG_PSTORE_FTRACE=y
