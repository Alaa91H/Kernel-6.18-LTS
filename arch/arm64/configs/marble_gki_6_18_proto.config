#
# POCO F5 (marble) GKI 6.18 prototype seed
#
# This is intentionally a safe, generic-GKI fragment. It does not attempt to
# select Xiaomi/Qualcomm 5.10-only drivers that are absent from ACK 6.18.
# It only asserts generic facilities already provided by gki_defconfig and
# serves as an auditable seed for future board enablement.
#
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_REMOTEPROC=y
CONFIG_REMOTEPROC_CDEV=y
CONFIG_RPMSG_CHAR=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# Ubuntu's packaged pahole cannot validate the BTF emitted for this ACK build.
# Keep the first host-only prototype buildable; re-enable BTF with Android's
# supported toolchain before any KMI-validated or device-targeted release.
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
