# Copy this file outside the repository and fill it from one exact Evolution X 17 build.
ROM_FLAVOR=evolutionx-17
DEVICE=marble

# Identity: do not leave these fields ambiguous.
ROM_VERSION=
ANDROID_VERSION=17
BUILD_FINGERPRINT=
BUILD_ID=
BUILD_DATE_UTC=
ROM_ZIP_SHA256=

# Absolute local paths to images extracted from the same ROM build.
BOOT_IMAGE=
VENDOR_BOOT_IMAGE=
DTBO_IMAGE=
VENDOR_DLKM_DIR=
SYSTEM_DLKM_DIR=
FIRMWARE_DIR=

# Record integrity and ABI evidence; do not store signing keys or proprietary images in Git.
INPUT_ARTIFACT_MANIFEST=
KMI_OR_ABI_REFERENCE=
AVB_POLICY=
SIGNING_KEY_PATH=

# Device test evidence, filled only after recovery and boot tests.
RECOVERY_EVIDENCE_DIR=
DEVICE_SERIAL=
